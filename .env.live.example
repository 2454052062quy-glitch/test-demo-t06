# ======================= T06 - BẢN LIVE (DỮ LIỆU THẬT CỦA QUÁN) =======================
# Chạy:  docker compose -p t06-live --env-file .env.live up -d
# Sao chép:  cp .env.live.example .env.live   rồi điền. KHÔNG BAO GIỜ commit file .env.live
# (đã nằm trong .gitignore). Tuyệt đối không để lộ mật khẩu, token, cookie trong kho mã nguồn.
#
# Kiến trúc tách biệt cổng Demo/Live: Live sử dụng cổng 3001/8001/5433, hoàn toàn độc lập với Demo (3000/8000/5432).
# Sử dụng project Compose riêng "t06-live" và cơ sở dữ liệu riêng "t06_live_db".
# Truy cập từ thiết bị di động trong cùng mạng LAN: http://<IP_LAN_MAY_CHU>:3001
APP_MODE=live
FRONTEND_PORT=3001
BACKEND_PORT=8001
DB_PORT=5433

DB_NAME=t06_live_db
DB_USER=t06_live
DB_PASSWORD=

# Thiết lập khởi tạo lần đầu (First-run Setup): Để trống OWNER_USERNAME thì lần đầu truy cập hệ thống sẽ
# hiển thị giao diện tạo tài khoản chủ quán, giúp không phải lưu mật khẩu quản trị trong file cấu hình.
OWNER_USERNAME=
OWNER_PASSWORD=

# Thời gian hết hạn phiên đăng nhập (tính theo giờ).
SESSION_HOURS=12
# Khóa ký bảo mật (cookie phiên, token QR). Cần thiết lập chuỗi ngẫu nhiên có độ phức tạp cao.
SECRET_KEY=
ATTENDANCE_QR_SECRET=

# Cấu hình tính năng: Ở môi trường Live, E01_ROLES và E02_AUTH luôn bắt buộc bật để bảo vệ dữ liệu nghiệp vụ.
E01_ROLES=true
E02_AUTH=true
E03_AUDIT=true
E04_SHIFT_TAG=true
E05_EXPORT=true
E09_QR_ATTENDANCE=true
E13_AUTO_DRAFT=true

# Địa chỉ gốc cho mã QR chấm công (mặc định để trống hệ thống sẽ tự phát hiện IP mạng LAN).
QR_BASE_URL=

# ---- Tích hợp POS365 của cửa hàng thật ----
# Địa chỉ URL truy cập cửa hàng POS365 (ví dụ: https://cuahanga.pos365.vn), không có dấu gạch chéo cuối.
POS365_BASE_URL=
POS365_USERNAME=
POS365_PASSWORD=

# Phương thức xác thực: 'credentials' (tự động đăng nhập lấy SessionId) hoặc 'none' (sử dụng Header Cookie tĩnh).
# Khi sử dụng POS365_AUTH_MODE=none, cấu hình POS365_EXTRA_HEADERS={"Cookie":"ss-id=<SessionId>"}
POS365_AUTH_MODE=credentials
POS365_EXTRA_HEADERS=

# Cấu hình phân trang OData cho POS365: Docker Compose yêu cầu escape $$top và $$skip.
POS365_TOP_PARAM=$$top
POS365_SKIP_PARAM=$$skip

# Giới hạn kích thước trang khi đồng bộ (mặc định 20 đơn/trang để đảm bảo ổn định đường truyền).
POS365_PAGE_SIZE=20

# Mốc ngày bắt đầu lấy dữ liệu đồng bộ (định dạng YYYY-MM-DD). Mặc định là ngày 1 của tháng trước.
POS365_SYNC_FROM_DATE=

# Giới hạn số trang tối đa cho mỗi phiên đồng bộ để tránh treo tiến trình khi dữ liệu lớn.
POS365_SYNC_MAX_PAGES=500

# Thời gian chờ tối đa (timeout tính bằng giây) cho mỗi request kết nối POS365.
POS365_REQUEST_TIMEOUT=30
